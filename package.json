{
  "name": "@linkurious/valcheck",
  "description": "A JavaScript value checker for NodeJS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linkurious/valcheck.git"
  },
  "author": {
    "name": "David Rapin",
    "url": "https://github.com/davidrapin"
  },
  "contributors": [
    {
      "name": "Francesco Infante",
      "url": "https://github.com/francescoinfante"
    }
  ],
  "bugs": {
    "url": "https://github.com/Linkurious/valcheck/issues"
  },
  "license": "MIT",
  "version": "1.2.8",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/*"
  ],
  "logo": "https://upload.wikimedia.org/wikipedia/en/a/a8/The_Wire_Valcheck.jpg",
  "keywords": [
    "validator",
    "check",
    "checker",
    "value",
    "validation"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16.18"
  },
  "scripts": {
    "make": "npm run lint && npm run build && npm run test",
    "clean": "rm -rf ./lib ./test-build ./node_modules ./coverage ./.nyc_output ./reports",
    "lint": "eslint --fix",
    "lint:ci": "mkdir -p reports && eslint --format checkstyle --output-file reports/checkstyle.xml",
    "test": "npm run build:test && nyc node --enable-source-maps --test 'test-build/**/*.test.js'",
    "test:unit": "npm run build:test && mkdir -p reports/unit && nyc --reporter=text-summary --reporter=cobertura --report-dir=reports/unit node --enable-source-maps --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=./reports/unit/junit-test-results.xml 'test-build/**/*.test.js'",
    "build": "npm run build:lib && npm run build:test",
    "build:lib": "tsc",
    "build:test": "rm -rf ./test-build && tsc -p test",
    "compile": "npm run build:lib",
    "bump:patch": "bump2version patch && npm version --no-git-tag-version patch",
    "bump:minor": "bump2version minor && npm version --no-git-tag-version minor"
  },
  "dependencies": {
    "lodash.difference": "4.5.0",
    "lodash.intersection": "4.4.0"
  },
  "nyc": {
    "reporter": [
      "html",
      "text-summary"
    ],
    "all": true
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/lodash.difference": "4.5.9",
    "@types/lodash.intersection": "4.4.9",
    "@types/node": "16.18.126",
    "eslint": "10.13.0",
    "eslint-formatter-checkstyle": "9.0.1",
    "nyc": "18.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
